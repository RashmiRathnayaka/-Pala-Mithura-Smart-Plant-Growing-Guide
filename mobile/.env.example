# Copy to mobile/.env  (optional)
#
# Address of the backend API as seen from your PHONE.
# Leave empty to auto-detect: the app uses the same computer that serves the Expo bundle,
# on port 5000 — this works for Expo Go on the same Wi-Fi in most cases.
#
# Set it explicitly if auto-detect fails, e.g. your computer's LAN IP (Windows: `ipconfig`):
# EXPO_PUBLIC_API_URL=http://192.168.1.20:5000
#
# Android emulator: http://10.0.2.2:5000      iOS simulator / web: http://localhost:5000
EXPO_PUBLIC_API_URL=
