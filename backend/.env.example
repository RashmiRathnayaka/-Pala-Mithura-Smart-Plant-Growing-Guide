# ─────────────────────────────────────────────────────────────
# පැළ මිතුරා (Pala Mithura) – backend environment variables
# Copy this file to `.env` and fill in your own values.
# NEVER commit the real .env file.
# ─────────────────────────────────────────────────────────────

# Server
NODE_ENV=development
PORT=5000
# Public base URL of this API. Used to build URLs for locally stored images.
# When testing on a phone, use your computer's LAN IP, e.g. http://192.168.1.20:5000
PUBLIC_BASE_URL=http://localhost:5000
# Comma-separated list of allowed CORS origins ("*" allows all – fine for local dev)
CORS_ORIGINS=*

# MongoDB
# Local:  mongodb://127.0.0.1:27017/pala_mithura
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/pala_mithura
MONGO_URI=mongodb://127.0.0.1:27017/pala_mithura

# JWT authentication
# Generate a long random value, e.g.:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Image storage
# STORAGE_PROVIDER=local      → images saved in backend/uploads (good for local testing)
# STORAGE_PROVIDER=cloudinary → images uploaded to Cloudinary (recommended for production)
STORAGE_PROVIDER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=pala-mithura
# Maximum upload size per image in megabytes (Claude accepts images up to 5 MB)
MAX_IMAGE_SIZE_MB=5

# AI provider
# AI_PROVIDER=anthropic → uses the Claude API (requires ANTHROPIC_API_KEY)
# AI_PROVIDER=mock      → offline rule-based analysis for local testing only.
#                         Results are clearly labelled as test output.
# If AI_PROVIDER=anthropic but no key is set, the server falls back to mock and logs a warning.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
AI_MAX_IMAGES=4
AI_TIMEOUT_MS=60000

# Seed accounts (used by `npm run seed`). Change these passwords before any real deployment.
SEED_ADMIN_EMAIL=admin@palamithura.lk
SEED_ADMIN_PASSWORD=Admin@12345
SEED_INSTRUCTOR_EMAIL=instructor@palamithura.lk
SEED_INSTRUCTOR_PASSWORD=Instructor@12345
SEED_USER_EMAIL=farmer@palamithura.lk
SEED_USER_PASSWORD=Farmer@12345
